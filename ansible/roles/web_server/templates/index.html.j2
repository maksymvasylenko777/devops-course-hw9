<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ web_server_page_title }}</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: #f6f8fb;
      color: #172033;
    }

    main {
      max-width: 720px;
      padding: 40px;
      border: 1px solid #d7dee9;
      background: #ffffff;
    }

    h1 {
      margin-top: 0;
    }
  </style>
</head>
<body>
  <main>
    <h1>{{ web_server_page_title }}</h1>
    <p>{{ web_server_page_message }}</p>
    <p>Managed host: {{ inventory_hostname }}</p>
  </main>
</body>
</html>
